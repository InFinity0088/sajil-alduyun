<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical">

    <!-- Colored dot indicator -->
    <View
        android:id="@+id/viewHistoryDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="#CFFF04"
        android:background="@drawable/bg_status_strip"/>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="زيادة"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvHistoryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-07-23 14:30"
                android:textColor="#6B9E7A"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistoryAmountChange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 → 50,000 د.ع"
            android:textColor="#CFFF04"
            android:textSize="13sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvHistoryBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بواسطة: Owner"
            android:textColor="#6B9E7A"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>
</LinearLayout>
