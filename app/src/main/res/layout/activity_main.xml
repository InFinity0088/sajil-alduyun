<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- App Title -->
    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/logo_main"
        android:contentDescription="سجل الديون"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سجّل دخولك"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="48dp"/>

    <!-- User ID Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/status_active_bg"
        app:boxStrokeWidth="1dp"
        app:hintTextColor="@color/text_secondary"
        app:boxBackgroundColor="@android:color/transparent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUserId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رمز المستخدم"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:padding="12dp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- PIN Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/status_active_bg"
        app:boxStrokeWidth="1dp"
        app:hintTextColor="@color/text_secondary"
        app:boxBackgroundColor="@android:color/transparent"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الرقم السري"
            android:inputType="numberPassword"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:padding="12dp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Error Message -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_locked_bg"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/status_locked"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Fingerprint Hint -->
    <TextView
        android:id="@+id/tvFingerprintHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بصّم إصبعك لتسجيل الدخول السريع..."
        android:textColor="@color/status_active"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/status_active_bg"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <!-- Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="دخول"
        android:backgroundTint="@color/primary"
        android:textColor="@color/primary_on"
        android:textSize="16sp"
        app:cornerRadius="12dp"/>

</LinearLayout>
