<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAccount"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginEnd="8dp"
    android:layout_marginStart="8dp"
    app:cardBackgroundColor="#132B1E"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Account Name -->
        <TextView
            android:id="@+id/tvAccountName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اسم الحساب"
            android:textColor="#CFFF04"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Account Role -->
        <TextView
            android:id="@+id/tvAccountRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المالك"
            android:textColor="#6B9E7A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- Account Status -->
        <TextView
            android:id="@+id/tvAccountStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نشط"
            android:textColor="#CFFF04"
            android:textSize="12sp"
            android:background="#1A3525"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
