<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2117"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="الرخصة منتهية"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="انتهت الرخصة"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تواصل مع المطور لتجديد الكود"
        android:textColor="#6B9E7A"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="#1A3525"
        app:hintTextColor="#6B9E7A"
        app:boxBackgroundColor="@android:color/transparent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRenewalCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رمز التجديد"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:padding="12dp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E0000"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRenewalError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FF4444"
            android:textSize="13sp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRenew"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="تجديد الرخصة"
        android:backgroundTint="#CFFF04"
        android:textColor="#0D2117"
        app:cornerRadius="12dp"
        android:layout_marginBottom="32dp"/>

    <!-- Revoke license -->
    <TextView
        android:id="@+id/tvToggleRevoke"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إبطال الترخيص على هذا الجهاز"
        android:textColor="#FF4444"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"/>

    <LinearLayout
        android:id="@+id/layoutRevoke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#1A3525"
            app:hintTextColor="#6B9E7A"
            app:boxBackgroundColor="@android:color/transparent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRevokeCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="رمز الإبطال"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRevoke"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="إبطال"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</LinearLayout>
