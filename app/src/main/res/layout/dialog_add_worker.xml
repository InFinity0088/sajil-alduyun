<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="20dp">

    <!-- Worker name label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اسم العامل"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/status_active_bg"
        app:hintTextColor="@color/text_secondary"
        app:boxBackgroundColor="@android:color/transparent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWorkerName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="مثال: أحمد محمد"
            android:inputType="textPersonName"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="12dp"
            android:gravity="end|center_vertical"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- PIN label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الرمز السري (4 أرقام)"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/status_active_bg"
        app:hintTextColor="@color/text_secondary"
        app:boxBackgroundColor="@android:color/transparent"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWorkerPin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="****"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:gravity="center"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm PIN label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تأكيد الرمز السري"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/status_active_bg"
        app:hintTextColor="@color/text_secondary"
        app:boxBackgroundColor="@android:color/transparent"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWorkerPinConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="****"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:gravity="center"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Validation error -->
    <TextView
        android:id="@+id/tvWorkerDialogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/status_locked"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>

</LinearLayout>
