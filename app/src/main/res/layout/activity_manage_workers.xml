<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Top Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:paddingTop="48dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="رجوع"
            app:tint="@color/text_primary"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="إدارة الموظفين"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvWorkerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/status_active_bg"
            android:text="العمال: ..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Content area: empty state or list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading overlay -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/primary"/>
        </LinearLayout>

        <!-- Error overlay -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حدث خطأ في الاتصال، تحقق من الإنترنت"
                android:textColor="@color/status_locked"
                android:textSize="15sp"
                android:gravity="center"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="إعادة المحاولة"
                android:backgroundTint="@color/primary"
                android:textColor="@color/primary_on"
                app:cornerRadius="12dp"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/tvEmptyWorkers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="لا يوجد عمال مسجلون.\nاضغط + لإضافة عامل جديد."
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.5"
            android:visibility="gone"/>

        <!-- List area with hint below -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Workers list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWorkers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="16dp"
                android:paddingBottom="88dp"
                android:clipToPadding="false"/>

            <!-- Hint shown when fewer than 3 workers exist -->
            <TextView
                android:id="@+id/tvWorkerHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اضغط + لإضافة موظف جديد"
                android:textColor="@color/status_active_bg"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingBottom="24dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddWorker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@drawable/ic_add"
            android:contentDescription="إضافة عامل"
            app:backgroundTint="@color/primary"
            app:tint="@color/primary_on"/>

    </FrameLayout>

</LinearLayout>
