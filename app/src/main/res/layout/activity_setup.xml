<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/logo_main"
            android:contentDescription="سجل الديون"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="من أنت؟"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:layout_marginBottom="32dp"/>

        <!-- Choice Buttons -->
        <LinearLayout
            android:id="@+id/layoutChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseOwner"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="مالك"
                android:textSize="20sp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/primary_on"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseWorker"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="موظف"
                android:textSize="20sp"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/primary"
                android:textColor="@color/status_active"/>

        </LinearLayout>

        <!-- Owner Form -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إنشاء حساب المالك"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="اسمك"
                        android:inputType="textPersonName"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Device ID card (machine-locking info) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/status_active_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="رقم جهازك:"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvDeviceId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="..."
                            android:textColor="@color/status_active"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center_horizontal"
                            android:letterSpacing="0.1"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyDeviceId"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="نسخ"
                            android:textSize="12sp"
                            android:backgroundTint="@color/snackbar_background"
                            android:textColor="@color/status_active"
                            app:cornerRadius="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="أرسل هذا الرقم إلى المسؤول لاستلام رمز الترخيص أو رمز التحويل"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLicenseCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="رمز الترخيص"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnerPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="الرقم السري"
                        android:inputType="numberPassword"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnerPinConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="تأكيد الرقم السري"
                        android:inputType="numberPassword"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="رقم الهاتف (07xxxxxxxxx)"
                        android:inputType="phone"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/layoutOwnerError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/status_locked_bg"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvOwnerError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/status_locked"
                        android:textSize="13sp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateOwner"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="إنشاء الحساب"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/primary_on"
                    app:cornerRadius="12dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Worker Form -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWorker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تسجيل موظف"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="اسمك"
                        android:inputType="textPersonName"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkerCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="رمز الموظف"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkerPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="الرقم السري"
                        android:inputType="numberPassword"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/status_active_bg"
                    app:hintTextColor="@color/text_secondary"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="رقم الهاتف (07xxxxxxxxx)"
                        android:inputType="phone"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/layoutWorkerError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/status_locked_bg"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvWorkerError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/status_locked"
                        android:textSize="13sp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterWorker"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="تسجيل"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/primary"
                    android:textColor="@color/status_active"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
